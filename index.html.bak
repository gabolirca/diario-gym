<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
<title>Diario de Entrenamiento · Gabo</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Diario Gym">
<meta name="theme-color" content="#0f1c19">
<meta name="format-detection" content="telephone=no">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-180.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<style>
:root{
  --bg:#0f1c19; --card:#162622; --card2:#1c2f2a; --line:#2a423b;
  --ink:#e8f0ed; --dim:#8fa8a0; --acc:#4ecfa8; --acc2:#2f6a5e;
  --warn:#e8a33d; --bad:#e2674f; --good:#4ecfa8;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;font-size:16px;line-height:1.5;
  -webkit-font-smoothing:antialiased;overscroll-behavior-y:none}
.wrap{max-width:1080px;margin:0 auto;
  padding:0 calc(16px + env(safe-area-inset-left)) calc(90px + env(safe-area-inset-bottom)) calc(16px + env(safe-area-inset-right))}

header{padding:calc(22px + env(safe-area-inset-top)) 0 16px;border-bottom:1px solid var(--line);margin-bottom:20px}
header h1{margin:0;font-size:22px;letter-spacing:-.3px}
header .s{color:var(--dim);font-size:13px;margin-top:4px}

nav{display:flex;gap:4px;overflow-x:auto;margin-bottom:22px;padding-bottom:4px}
nav button{background:none;border:none;color:var(--dim);padding:9px 15px;border-radius:8px;
  font-size:14px;cursor:pointer;white-space:nowrap;font-family:inherit;font-weight:500}
nav button:hover{color:var(--ink)}
nav button.on{background:var(--acc);color:#08201a;font-weight:600}

.tab{display:none} .tab.on{display:block}

.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:16px}
.card h2{margin:0 0 4px;font-size:16px;letter-spacing:-.2px}
.card h2 + .sub{color:var(--dim);font-size:13px;margin:0 0 14px}
.card h3{margin:18px 0 8px;font-size:14px;color:var(--acc)}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:16px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
.kpi .l{color:var(--dim);font-size:11px;text-transform:uppercase;letter-spacing:.8px}
.kpi .v{font-size:27px;font-weight:700;margin-top:6px;letter-spacing:-1px}
.kpi .d{font-size:12px;margin-top:3px;color:var(--dim)}
.kpi .d.up{color:var(--bad)} .kpi .d.dn{color:var(--good)}

.bar{height:8px;background:var(--card2);border-radius:99px;overflow:hidden;margin:10px 0 6px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--acc2),var(--acc));border-radius:99px}

label{display:block;font-size:12px;color:var(--dim);margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px}
input,select,textarea{width:100%;background:var(--card2);border:1px solid var(--line);color:var(--ink);
  padding:12px;border-radius:8px;font-size:16px;font-family:inherit;-webkit-appearance:none}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--acc)}
textarea{resize:vertical;min-height:60px}
.row{display:grid;gap:12px;margin-bottom:14px}
.r2{grid-template-columns:1fr 1fr} .r3{grid-template-columns:1fr 1fr 1fr} .r4{grid-template-columns:repeat(4,1fr)}
@media(max-width:640px){.r3,.r4{grid-template-columns:1fr 1fr}}

button.btn{background:var(--acc);color:#08201a;border:none;padding:11px 20px;border-radius:8px;
  font-size:14px;font-weight:600;cursor:pointer;font-family:inherit}
button.btn:hover{filter:brightness(1.1)}
button.gh{background:none;border:1px solid var(--line);color:var(--dim)}
button.gh:hover{color:var(--ink);border-color:var(--acc)}
button.sm{padding:6px 12px;font-size:12px}

table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;color:var(--dim);font-size:11px;text-transform:uppercase;letter-spacing:.6px;
  padding:8px 8px;border-bottom:1px solid var(--line);font-weight:500}
td{padding:9px 8px;border-bottom:1px solid var(--line)}
tr:last-child td{border-bottom:none}
.tw{overflow-x:auto}

.ex{border:1px solid var(--line);border-radius:10px;margin-bottom:10px;overflow:hidden}
.ex .eh{background:var(--card2);padding:10px 13px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.ex .eh b{font-size:14px} .ex .eh .tgt{color:var(--dim);font-size:12px;white-space:nowrap}
.ex .last{padding:6px 13px;font-size:12px;color:var(--warn);background:rgba(232,163,61,.07)}
.ex .sets{padding:10px 13px}
.set{display:grid;grid-template-columns:26px 1fr 1fr 34px;gap:8px;align-items:center;margin-bottom:7px}
.set span.n{color:var(--dim);font-size:12px;text-align:center}
.set input{padding:11px 10px;font-size:16px}
.set button{background:none;border:none;color:var(--dim);cursor:pointer;font-size:17px;padding:0}
.set button:hover{color:var(--bad)}

.chip{display:inline-block;padding:2px 9px;border-radius:99px;font-size:11px;font-weight:600}
.c-ok{background:rgba(78,207,168,.15);color:var(--acc)}
.c-w{background:rgba(232,163,61,.15);color:var(--warn)}
.c-b{background:rgba(226,103,79,.15);color:var(--bad)}

.empty{color:var(--dim);text-align:center;padding:32px 16px;font-size:14px}
.chart{width:100%;height:230px}
.lg{display:flex;gap:16px;font-size:12px;color:var(--dim);margin-top:8px;flex-wrap:wrap}
.lg i{display:inline-block;width:16px;height:2px;vertical-align:middle;margin-right:5px}
.note{font-size:12px;color:var(--dim);margin-top:10px;line-height:1.6}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(90px);
  background:var(--acc);color:#08201a;padding:11px 22px;border-radius:99px;font-weight:600;
  font-size:14px;transition:transform .28s;z-index:99}
.toast.on{transform:translateX(-50%) translateY(0)}
.pr{color:var(--acc);font-weight:600}
nav{position:sticky;top:0;background:var(--bg);z-index:20;padding-top:6px;
  scrollbar-width:none;-ms-overflow-style:none}
nav::-webkit-scrollbar{display:none}
button.btn{min-height:46px}
button.btn.sm{min-height:34px}
#iosHint{display:none;background:var(--card2);border:1px solid var(--acc2);border-radius:12px;
  padding:14px 16px;margin-bottom:16px;font-size:14px;line-height:1.6}
#iosHint b{color:var(--acc)}
#iosHint button{background:none;border:none;color:var(--dim);font-size:13px;
  text-decoration:underline;cursor:pointer;padding:6px 0 0;font-family:inherit}
@media(max-width:640px){
  .wrap{padding-left:calc(13px + env(safe-area-inset-left));padding-right:calc(13px + env(safe-area-inset-right))}
  header h1{font-size:19px}
  .card{padding:15px}
  .kpi .v{font-size:24px}
  nav button{padding:9px 13px;font-size:13.5px}
  .set{grid-template-columns:22px 1fr 1fr 32px;gap:6px}
  th,td{padding:8px 6px;font-size:12.5px}
}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Diario de Entrenamiento</h1>
  <div class="s">Gabo · Plan de recomposición 26 semanas · <span id="hdWeek">—</span></div>
</header>

<div id="iosHint">
  <b>Instálalo como app.</b> Toca el botón Compartir de Safari
  <span style="font-size:16px">&#x2934;</span> y elige <b>"Añadir a pantalla de inicio"</b>.
  Te queda con su ícono, en pantalla completa y funcionando sin internet.
  <br><button onclick="hideHint()">No mostrar de nuevo</button>
</div>

<nav>
  <button class="on" data-t="panel">Panel</button>
  <button data-t="pesas">Pesas</button>
  <button data-t="cuerpo">Peso y medidas</button>
  <button data-t="nado">Natación</button>
  <button data-t="prog">Progreso</button>
  <button data-t="datos">Datos</button>
</nav>

<!-- ================= PANEL ================= -->
<div class="tab on" id="t-panel">
  <div class="kpis">
    <div class="kpi"><div class="l">Promedio 7 días</div><div class="v" id="kAvg">—</div><div class="d" id="kAvgD">Sin datos</div></div>
    <div class="kpi"><div class="l">Objetivo esta semana</div><div class="v" id="kTgt">—</div><div class="d" id="kTgtD">—</div></div>
    <div class="kpi"><div class="l">Cintura</div><div class="v" id="kCin">—</div><div class="d" id="kCinD">Meta: 82 cm</div></div>
    <div class="kpi"><div class="l">Grasa estimada</div><div class="v" id="kBf">—</div><div class="d" id="kBfD">Meta: 15%</div></div>
  </div>

  <div class="card">
    <h2>Progreso general</h2>
    <p class="sub">De 75.6 kg a 65.0 kg · 10.6 kg de grasa a perder</p>
    <div class="bar"><i id="pbPeso" style="width:0%"></i></div>
    <div class="note" id="pbPesoT">Registra tu peso para empezar.</div>
    <div class="bar" style="margin-top:16px"><i id="pbCin" style="width:0%"></i></div>
    <div class="note" id="pbCinT">Registra tu cintura para empezar.</div>
  </div>

  <div class="card">
    <h2>Registro rápido de hoy</h2>
    <p class="sub">Lo que deberías capturar todos los días al despertar.</p>
    <div class="row r3">
      <div><label>Fecha</label><input type="date" id="qDate"></div>
      <div><label>Peso (kg)</label><input type="number" inputmode="decimal" step="0.1" id="qKg" placeholder="75.6"></div>
      <div><label>Horas de sueño</label><input type="number" inputmode="decimal" step="0.5" id="qSleep" placeholder="7.5"></div>
    </div>
    <button class="btn" onclick="quickSave()">Guardar</button>
  </div>

  <div class="card">
    <h2>Esta semana</h2>
    <p class="sub">5 sesiones de pesas · 3 de natación · 1 de zona 2</p>
    <div id="weekGrid"></div>
  </div>

  <div class="card">
    <h2>Últimas sesiones</h2>
    <div id="recent"><div class="empty">Todavía no hay entrenamientos registrados.</div></div>
  </div>
</div>

<!-- ================= PESAS ================= -->
<div class="tab" id="t-pesas">
  <div class="card">
    <h2>Registrar sesión</h2>
    <p class="sub">Los pesos de la última vez aparecen arriba de cada ejercicio. Tu trabajo es igualarlos o superarlos.</p>
    <div class="row r2">
      <div><label>Fecha</label><input type="date" id="wDate"></div>
      <div><label>Rutina</label><select id="wRoutine" onchange="renderExercises()"></select></div>
    </div>
    <div id="exList"></div>
    <div class="row"><div><label>Notas (energía, dolor, cómo se sintió)</label><textarea id="wNotes" placeholder="Buena energía, banca subió 2.5 kg..."></textarea></div></div>
    <button class="btn" onclick="saveWorkout()">Guardar sesión</button>
  </div>

  <div class="card">
    <h2>Récords personales</h2>
    <p class="sub">Peso máximo y 1RM estimado (fórmula Epley) por ejercicio.</p>
    <div class="tw"><table id="prTable"></table></div>
    <div class="note">En déficit calórico <b>mantener estos números ya es ganar</b>. Si empiezan a caer más de 10%, revisa proteína, sueño y carbohidratos pre-entreno.</div>
  </div>

  <div class="card">
    <h2>Historial</h2>
    <div class="tw"><table id="wHist"></table></div>
  </div>
</div>

<!-- ================= CUERPO ================= -->
<div class="tab" id="t-cuerpo">
  <div class="card">
    <h2>Peso diario</h2>
    <p class="sub">Al despertar, después del baño, sin ropa. Solo importa el promedio de 7 días.</p>
    <div class="row r2">
      <div><label>Fecha</label><input type="date" id="pDate"></div>
      <div><label>Peso (kg)</label><input type="number" inputmode="decimal" step="0.1" id="pKg" placeholder="75.6"></div>
    </div>
    <button class="btn" onclick="saveWeight()">Guardar peso</button>
  </div>

  <div class="card">
    <h2>Medidas semanales</h2>
    <p class="sub">Domingos. De pie, relajado, sin meter la panza, al exhalar normal.</p>
    <div class="row r3">
      <div><label>Fecha</label><input type="date" id="mDate"></div>
      <div><label>Cintura (cm)</label><input type="number" inputmode="decimal" step="0.1" id="mCin" placeholder="96.5"></div>
      <div><label>Cuello (cm)</label><input type="number" inputmode="decimal" step="0.1" id="mCue" placeholder="37.8"></div>
    </div>
    <div class="row r4">
      <div><label>Pecho (cm)</label><input type="number" inputmode="decimal" step="0.1" id="mPec" placeholder="102.5"></div>
      <div><label>Brazo (cm)</label><input type="number" inputmode="decimal" step="0.1" id="mBra" placeholder="38"></div>
      <div><label>Muslo (cm)</label><input type="number" inputmode="decimal" step="0.1" id="mMus"></div>
      <div><label>Cadera (cm)</label><input type="number" inputmode="decimal" step="0.1" id="mCad" placeholder="93"></div>
    </div>
    <button class="btn" onclick="saveMeasure()">Guardar medidas</button>
    <div class="note">Con cintura + cuello se calcula tu porcentaje de grasa por la fórmula Navy. Margen de error ±3-4 puntos: sirve para ver la <b>tendencia</b>, no como valor absoluto.</div>
  </div>

  <div class="card">
    <h2>Historial corporal</h2>
    <div class="tw"><table id="bHist"></table></div>
  </div>
</div>

<!-- ================= NADO ================= -->
<div class="tab" id="t-nado">
  <div class="card">
    <h2>Registrar natación</h2>
    <p class="sub">Lo importante no son los metros: es cuánto tardas en hacerlos.</p>
    <div class="row r4">
      <div><label>Fecha</label><input type="date" id="sDate"></div>
      <div><label>Tipo</label><select id="sType">
        <option value="int">Intervalos (10×100)</option>
        <option value="cont">Continuo suave</option>
        <option value="tec">Técnica</option>
      </select></div>
      <div><label>Metros</label><input type="number" inputmode="decimal" id="sM" placeholder="1700"></div>
      <div><label>Minutos</label><input type="number" inputmode="decimal" id="sMin" placeholder="45"></div>
    </div>
    <div class="row r2">
      <div><label>Promedio por 100 m (mm:ss)</label><input type="text" id="sPace" placeholder="2:05"></div>
      <div><label>Notas</label><input type="text" id="sNotes" placeholder="Último 100 costó..."></div>
    </div>
    <button class="btn" onclick="saveSwim()">Guardar</button>
    <div class="note">Tu marcador de condición es el <b>ritmo por 100 m en la serie de intervalos</b>. Si en el mes 3 nadas los mismos 100 m más rápido con el mismo descanso, mejoraste — aunque la báscula se haya estancado.</div>
  </div>

  <div class="card">
    <h2>Historial de natación</h2>
    <div class="tw"><table id="sHist"></table></div>
  </div>
</div>

<!-- ================= PROGRESO ================= -->
<div class="tab" id="t-prog">
  <div class="card">
    <h2>Peso: real vs. objetivo</h2>
    <p class="sub">Promedio semanal contra la curva del plan.</p>
    <svg class="chart" id="chPeso"></svg>
    <div class="lg"><span><i style="background:var(--acc)"></i>Tu promedio real</span><span><i style="background:var(--dim)"></i>Objetivo del plan</span></div>
  </div>

  <div class="card">
    <h2>Cintura: real vs. objetivo</h2>
    <p class="sub">La métrica que mejor refleja la grasa abdominal.</p>
    <svg class="chart" id="chCin"></svg>
    <div class="lg"><span><i style="background:var(--acc)"></i>Tu cintura</span><span><i style="background:var(--dim)"></i>Objetivo del plan</span></div>
  </div>

  <div class="card">
    <h2>Volumen semanal de pesas</h2>
    <p class="sub">Toneladas movidas por semana (peso × reps sumado). Si cae mucho, estás perdiendo capacidad de trabajo.</p>
    <svg class="chart" id="chVol"></svg>
  </div>

  <div class="card">
    <h2>Tabla del plan</h2>
    <div class="tw"><table id="planTable"></table></div>
  </div>
</div>

<!-- ================= DATOS ================= -->
<div class="tab" id="t-datos">
  <div class="card">
    <h2>Respaldo</h2>
    <p class="sub">Tus datos viven en este navegador. Si borras el historial o cambias de compu, se pierden. Exporta cada mes.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <button class="btn" onclick="exportData()">Descargar respaldo</button>
      <button class="btn gh" onclick="document.getElementById('impF').click()">Importar respaldo</button>
      <input type="file" id="impF" accept=".json" style="display:none" onchange="importData(event)">
    </div>
  </div>

  <div class="card">
    <h2>Configuración</h2>
    <div class="row r3">
      <div><label>Inicio del plan (semana 1)</label><input type="date" id="cfgStart" onchange="saveCfg()"></div>
      <div><label>Altura (cm)</label><input type="number" inputmode="decimal" id="cfgH" step="0.5" onchange="saveCfg()"></div>
      <div><label>Peso inicial (kg)</label><input type="number" inputmode="decimal" id="cfgW0" step="0.1" onchange="saveCfg()"></div>
    </div>
  </div>

  <div class="card">
    <h2>Borrar todo</h2>
    <p class="sub">Elimina permanentemente todos tus registros. No se puede deshacer.</p>
    <button class="btn gh" style="border-color:var(--bad);color:var(--bad)" onclick="wipe()">Borrar todos los datos</button>
  </div>
</div>

</div>
<div class="toast" id="toast"></div>

<script>
/* ============ DATOS BASE ============ */
const ROUTINES = {
  upperA:{name:"Upper A — Empuje", ex:[
    ["Press banca inclinado","4 × 8"],["Press militar con barra","4 × 10"],["Fondos en paralelas","3 × 10"],
    ["Aperturas con mancuerna","3 × 12"],["Extensión de tríceps en polea","3 × 12"],["Elevaciones laterales","3 × 15"]]},
  lowerA:{name:"Lower A — Fuerza", ex:[
    ["Sentadilla hack","4 × 8"],["Peso muerto","4 × 6"],["Prensa","3 × 10"],
    ["Curl femoral","3 × 12"],["Pantorrilla","4 × 15"]]},
  upperB:{name:"Upper B — Jale", ex:[
    ["Dominadas","4 × máx"],["Jalón al pecho","3 × 12"],["Remo unilateral mancuerna","4 × 10"],
    ["Remo alto abierto","3 × 12"],["Curl de bíceps con barra","3 × 10"],["Antebrazo","3 × 15"]]},
  lowerB:{name:"Lower B — Volumen", ex:[
    ["Sentadilla goblet","3 × 12"],["Extensión de cuádriceps","4 × 12"],["Desplantes","3 × 15"],
    ["Búlgaras","3 × 12"],["Hiperextensión baja","3 × 15"],["Abductor","3 × 15"]]},
  upperC:{name:"Upper C — Hombro y brazo", ex:[
    ["Press militar mancuernas","3 × 12"],["Elevaciones frontales","3 × 12"],["Posterior (pájaros)","4 × 15"],
    ["Curl spider","3 × 12"],["Press francés","3 × 12"],["Trabajo de cuello","2 × 15"]]}
};
const PLAN = [[75.2,96.0],[74.7,95.2],[74.1,94.3],[73.5,93.0],[73.0,92.3],[72.6,91.5],[72.1,90.8],[71.5,90.0],
[71.1,89.5],[70.8,89.0],[70.4,88.5],[70.0,88.0],[70.0,88.0],[69.4,87.3],[68.9,86.7],[68.0,86.0],
[67.7,85.6],[67.4,85.2],[67.1,84.7],[66.5,84.0],[66.2,83.6],[65.9,83.1],[65.5,82.6],[65.0,82.0],[65.0,82.0],[65.0,82.0]];
const PHASE = w => w<=8?1:w<=16?2:w<=24?3:4;
const KCAL  = w => w<=8?"2,100":w<=16?(w===12||w===13?"2,400 (diet break)":"2,000"):w<=24?"1,950":"~2,300";
const KEY = "gymDiary_gabo_v1";

let D = load();
function load(){
  try{ const r = localStorage.getItem(KEY); if(r) return JSON.parse(r); }catch(e){}
  return {weights:[],measures:[],workouts:[],swims:[],sleep:[],
          cfg:{start:"2026-08-03",height:166,w0:75.6}};
}
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(D)); }catch(e){ toast("No se pudo guardar"); } }
function toast(m){ const t=document.getElementById('toast'); t.textContent=m; t.classList.add('on');
  setTimeout(()=>t.classList.remove('on'),2000); }
const today = () => new Date().toISOString().slice(0,10);
const fmt = d => { const [y,m,dd]=d.split('-'); return dd+'/'+m; };

function weekOf(dateStr){
  const s = new Date(D.cfg.start+"T00:00:00"), d = new Date(dateStr+"T00:00:00");
  const w = Math.floor((d-s)/(7*864e5))+1;
  return Math.min(Math.max(w,1),26);
}
function curWeek(){ return weekOf(today()); }

/* ============ NAVEGACIÓN ============ */
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('nav button').forEach(x=>x.classList.remove('on'));
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
  b.classList.add('on'); document.getElementById('t-'+b.dataset.t).classList.add('on');
  if(b.dataset.t==='prog') drawCharts();
});

/* ============ GUARDADO ============ */
function upsert(arr,obj){ const i=arr.findIndex(x=>x.date===obj.date);
  if(i>=0) arr[i]={...arr[i],...obj}; else arr.push(obj); arr.sort((a,b)=>a.date<b.date?-1:1); }

function quickSave(){
  const d=document.getElementById('qDate').value, kg=parseFloat(document.getElementById('qKg').value),
        sl=parseFloat(document.getElementById('qSleep').value);
  if(!d) return toast("Falta la fecha");
  if(kg) upsert(D.weights,{date:d,kg});
  if(sl) upsert(D.sleep,{date:d,h:sl});
  save(); render(); toast("Guardado");
  document.getElementById('qKg').value=''; document.getElementById('qSleep').value='';
}
function saveWeight(){
  const d=document.getElementById('pDate').value, kg=parseFloat(document.getElementById('pKg').value);
  if(!d||!kg) return toast("Faltan datos");
  upsert(D.weights,{date:d,kg}); save(); render(); toast("Peso guardado");
  document.getElementById('pKg').value='';
}
function saveMeasure(){
  const g=id=>parseFloat(document.getElementById(id).value)||null;
  const d=document.getElementById('mDate').value;
  if(!d) return toast("Falta la fecha");
  upsert(D.measures,{date:d,cin:g('mCin'),cue:g('mCue'),pec:g('mPec'),bra:g('mBra'),mus:g('mMus'),cad:g('mCad')});
  save(); render(); toast("Medidas guardadas");
}
function saveSwim(){
  const d=document.getElementById('sDate').value;
  if(!d) return toast("Falta la fecha");
  D.swims.push({date:d,type:document.getElementById('sType').value,
    m:parseFloat(document.getElementById('sM').value)||0,
    min:parseFloat(document.getElementById('sMin').value)||0,
    pace:document.getElementById('sPace').value, notes:document.getElementById('sNotes').value});
  D.swims.sort((a,b)=>a.date<b.date?-1:1); save(); render(); toast("Natación guardada");
  ['sM','sMin','sPace','sNotes'].forEach(i=>document.getElementById(i).value='');
}

/* ============ PESAS ============ */
function lastFor(exName){
  for(let i=D.workouts.length-1;i>=0;i--){
    const s=D.workouts[i].sets.filter(x=>x.ex===exName);
    if(s.length) return {date:D.workouts[i].date, sets:s};
  } return null;
}
function renderExercises(){
  const r=document.getElementById('wRoutine').value, box=document.getElementById('exList');
  box.innerHTML='';
  ROUTINES[r].ex.forEach((e,ei)=>{
    const [nm,tgt]=e, last=lastFor(nm);
    const d=document.createElement('div'); d.className='ex';
    let h=`<div class="eh"><b>${nm}</b><span class="tgt">${tgt}</span></div>`;
    if(last) h+=`<div class="last">Última vez (${fmt(last.date)}): ${last.sets.map(s=>s.w+'kg × '+s.r).join('  ·  ')}</div>`;
    h+=`<div class="sets" id="sets-${ei}"></div>
        <div style="padding:0 13px 11px"><button class="btn gh sm" onclick="addSet(${ei})">+ Serie</button></div>`;
    d.innerHTML=h; box.appendChild(d);
    const n=parseInt(tgt)||3; for(let i=0;i<n;i++) addSet(ei);
  });
}
function addSet(ei){
  const c=document.getElementById('sets-'+ei), n=c.children.length+1;
  const row=document.createElement('div'); row.className='set';
  row.innerHTML=`<span class="n">${n}</span>
    <input type="number" inputmode="decimal" step="0.5" placeholder="kg" class="sw">
    <input type="number" inputmode="decimal" placeholder="reps" class="sr">
    <button onclick="this.parentNode.remove()">×</button>`;
  c.appendChild(row);
}
function saveWorkout(){
  const d=document.getElementById('wDate').value, r=document.getElementById('wRoutine').value;
  if(!d) return toast("Falta la fecha");
  const sets=[];
  ROUTINES[r].ex.forEach((e,ei)=>{
    document.querySelectorAll('#sets-'+ei+' .set').forEach(row=>{
      const w=parseFloat(row.querySelector('.sw').value), rp=parseInt(row.querySelector('.sr').value);
      if(w>0&&rp>0) sets.push({ex:e[0],w,r:rp});
    });
  });
  if(!sets.length) return toast("Captura al menos una serie");
  D.workouts.push({date:d,routine:r,sets,notes:document.getElementById('wNotes').value});
  D.workouts.sort((a,b)=>a.date<b.date?-1:1);
  save(); document.getElementById('wNotes').value=''; renderExercises(); render();
  toast("Sesión guardada: "+sets.length+" series");
}
const e1rm=(w,r)=>w*(1+r/30);

/* ============ RENDER ============ */
function avg7(){
  if(!D.weights.length) return null;
  const last=D.weights.slice(-7); return last.reduce((a,b)=>a+b.kg,0)/last.length;
}
function prevAvg7(){
  if(D.weights.length<8) return null;
  const p=D.weights.slice(-14,-7); if(!p.length) return null;
  return p.reduce((a,b)=>a+b.kg,0)/p.length;
}
function bodyFat(cin,cue){
  const h=D.cfg.height; if(!cin||!cue||cin<=cue) return null;
  const v=1.0324-0.19077*Math.log10(cin-cue)+0.15456*Math.log10(h);
  return 495/v-450;
}
function lastMeasure(){ return D.measures.length?D.measures[D.measures.length-1]:null; }

function render(){
  const w=curWeek();
  document.getElementById('hdWeek').textContent=`Semana ${w} de 26 · Fase ${PHASE(w)} · ${KCAL(w)} kcal`;

  // KPIs
  const a=avg7(), pa=prevAvg7(), tgt=PLAN[w-1];
  document.getElementById('kAvg').textContent = a? a.toFixed(1)+' kg':'—';
  const dEl=document.getElementById('kAvgD');
  if(a&&pa){ const df=a-pa; dEl.textContent=(df>0?'+':'')+df.toFixed(2)+' kg vs. semana pasada';
    dEl.className='d '+(df<0?'dn':'up'); }
  else dEl.textContent = a? D.weights.length+' registros':'Sin datos';

  document.getElementById('kTgt').textContent=tgt[0].toFixed(1)+' kg';
  document.getElementById('kTgtD').textContent = a? (a<=tgt[0]?'✓ Vas bien':'Estás '+(a-tgt[0]).toFixed(1)+' kg arriba') : 'Semana '+w;

  const m=lastMeasure();
  document.getElementById('kCin').textContent = m&&m.cin? m.cin.toFixed(1)+' cm':'—';
  document.getElementById('kCinD').textContent = m&&m.cin? 'Objetivo: '+tgt[1].toFixed(1)+' cm':'Meta final: 82 cm';
  const bf = m? bodyFat(m.cin,m.cue):null;
  document.getElementById('kBf').textContent = bf? bf.toFixed(1)+'%':'—';

  // Barras
  const pk = a? Math.min(100,Math.max(0,(75.6-a)/10.6*100)):0;
  document.getElementById('pbPeso').style.width=pk+'%';
  document.getElementById('pbPesoT').textContent = a
    ? `Peso: ${(75.6-a).toFixed(1)} kg perdidos de 10.6 · ${pk.toFixed(0)}% del camino · faltan ${(a-65).toFixed(1)} kg`
    : 'Registra tu peso para empezar.';
  const pc = m&&m.cin? Math.min(100,Math.max(0,(96.5-m.cin)/14.5*100)):0;
  document.getElementById('pbCin').style.width=pc+'%';
  document.getElementById('pbCinT').textContent = m&&m.cin
    ? `Cintura: ${(96.5-m.cin).toFixed(1)} cm perdidos de 14.5 · ${pc.toFixed(0)}% del camino · faltan ${(m.cin-82).toFixed(1)} cm`
    : 'Registra tu cintura para empezar.';

  // Semana
  const days=['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'];
  const plan=[['Nado 1,500 m intervalos','Upper A — empuje'],['—','Lower A — fuerza (día alto)'],
    ['Nado 1,700 m intervalos','Upper B — jale'],['—','Lower B — volumen (día alto)'],
    ['Nado 1,500 m continuo','Upper C — hombro y brazo'],['—','Zona 2 · 45 min + core'],['—','Descanso · meal prep']];
  document.getElementById('weekGrid').innerHTML='<div class="tw"><table><tr><th>Día</th><th>AM</th><th>PM</th></tr>'+
    days.map((d,i)=>`<tr><td><b>${d}</b></td><td style="color:var(--dim)">${plan[i][0]}</td><td>${plan[i][1]}</td></tr>`).join('')+'</table></div>';

  // Recientes
  const rc=D.workouts.slice(-5).reverse();
  document.getElementById('recent').innerHTML = rc.length
    ? '<div class="tw"><table><tr><th>Fecha</th><th>Rutina</th><th>Series</th><th>Volumen</th></tr>'+
      rc.map(x=>{const v=x.sets.reduce((s,y)=>s+y.w*y.r,0);
      return `<tr><td>${fmt(x.date)}</td><td>${ROUTINES[x.routine].name}</td><td>${x.sets.length}</td><td>${(v/1000).toFixed(1)} t</td></tr>`}).join('')+'</table></div>'
    : '<div class="empty">Todavía no hay entrenamientos registrados.</div>';

  // PRs
  const prs={};
  D.workouts.forEach(wk=>wk.sets.forEach(s=>{
    if(!prs[s.ex]) prs[s.ex]={w:0,rm:0,d:'',n:0};
    prs[s.ex].n++;
    if(s.w>prs[s.ex].w){prs[s.ex].w=s.w;prs[s.ex].d=wk.date;}
    const rm=e1rm(s.w,s.r); if(rm>prs[s.ex].rm) prs[s.ex].rm=rm;
  }));
  const pk2=Object.keys(prs);
  document.getElementById('prTable').innerHTML = pk2.length
    ? '<tr><th>Ejercicio</th><th>Peso máx</th><th>1RM est.</th><th>Series</th><th>Fecha</th></tr>'+
      pk2.sort().map(k=>`<tr><td>${k}</td><td class="pr">${prs[k].w} kg</td><td>${prs[k].rm.toFixed(1)} kg</td><td>${prs[k].n}</td><td style="color:var(--dim)">${fmt(prs[k].d)}</td></tr>`).join('')
    : '<tr><td class="empty">Registra sesiones para ver tus récords.</td></tr>';

  // Historial pesas
  const wh=D.workouts.slice().reverse();
  document.getElementById('wHist').innerHTML = wh.length
    ? '<tr><th>Fecha</th><th>Sem</th><th>Rutina</th><th>Volumen</th><th>Notas</th><th></th></tr>'+
      wh.map((x,i)=>{const v=x.sets.reduce((s,y)=>s+y.w*y.r,0); const idx=D.workouts.length-1-i;
      return `<tr><td>${fmt(x.date)}</td><td>${weekOf(x.date)}</td><td>${ROUTINES[x.routine].name}</td>
      <td>${(v/1000).toFixed(2)} t</td><td style="color:var(--dim)">${x.notes||'—'}</td>
      <td><button class="btn gh sm" onclick="del('workouts',${idx})">borrar</button></td></tr>`}).join('')
    : '<tr><td class="empty">Sin sesiones.</td></tr>';

  // Historial cuerpo
  const rows=[];
  D.measures.slice().reverse().forEach((x,i)=>{
    const idx=D.measures.length-1-i, b=bodyFat(x.cin,x.cue);
    rows.push(`<tr><td>${fmt(x.date)}</td><td>${weekOf(x.date)}</td><td>${x.cin??'—'}</td><td>${b?b.toFixed(1)+'%':'—'}</td>
    <td>${x.pec??'—'}</td><td>${x.bra??'—'}</td><td>${x.mus??'—'}</td>
    <td><button class="btn gh sm" onclick="del('measures',${idx})">borrar</button></td></tr>`);
  });
  document.getElementById('bHist').innerHTML = rows.length
    ? '<tr><th>Fecha</th><th>Sem</th><th>Cintura</th><th>% grasa</th><th>Pecho</th><th>Brazo</th><th>Muslo</th><th></th></tr>'+rows.join('')
    : '<tr><td class="empty">Sin medidas registradas.</td></tr>';

  // Nado
  const TY={int:'Intervalos',cont:'Continuo',tec:'Técnica'};
  const sh=D.swims.slice().reverse();
  document.getElementById('sHist').innerHTML = sh.length
    ? '<tr><th>Fecha</th><th>Tipo</th><th>Metros</th><th>Min</th><th>Ritmo /100m</th><th>Notas</th><th></th></tr>'+
      sh.map((x,i)=>{const idx=D.swims.length-1-i;
      return `<tr><td>${fmt(x.date)}</td><td>${TY[x.type]}</td><td>${x.m}</td><td>${x.min}</td>
      <td class="pr">${x.pace||'—'}</td><td style="color:var(--dim)">${x.notes||'—'}</td>
      <td><button class="btn gh sm" onclick="del('swims',${idx})">borrar</button></td></tr>`}).join('')
    : '<tr><td class="empty">Sin sesiones de natación.</td></tr>';

  // Tabla plan
  document.getElementById('planTable').innerHTML='<tr><th>Sem</th><th>Fase</th><th>Kcal</th><th>Peso obj.</th><th>Cintura obj.</th><th>Hito</th></tr>'+
    PLAN.map((p,i)=>{const n=i+1, hit=[4,8,12,16,20,24,26].includes(n)?(n===12||n===13?'Diet break · fotos':n===24?'META · fotos':'Fotos'):'';
    return `<tr${n===w?' style="background:rgba(78,207,168,.09)"':''}><td>${n}</td><td>${PHASE(n)}</td><td>${KCAL(n)}</td>
    <td>${p[0].toFixed(1)}</td><td>${p[1].toFixed(1)}</td><td class="pr">${hit}</td></tr>`}).join('');
}
function del(k,i){ if(!confirm('¿Borrar este registro?')) return; D[k].splice(i,1); save(); render(); toast('Borrado'); }

/* ============ GRÁFICAS SVG ============ */
function line(svgId, series, yLab){
  const svg=document.getElementById(svgId); const W=800,H=230,P={t:16,r:14,b:26,l:42};
  svg.setAttribute('viewBox',`0 0 ${W} ${H}`); svg.innerHTML='';
  const all=series.flatMap(s=>s.pts.map(p=>p[1])).filter(v=>v!=null);
  if(!all.length){ svg.innerHTML=`<text x="${W/2}" y="${H/2}" fill="#8fa8a0" font-size="14" text-anchor="middle">Sin datos todavía</text>`; return; }
  let mn=Math.min(...all), mx=Math.max(...all); const pad=(mx-mn)*.15||1; mn-=pad; mx+=pad;
  const xs=series.flatMap(s=>s.pts.map(p=>p[0]));
  const x0=Math.min(...xs), x1=Math.max(...xs)||1;
  const X=v=>P.l+(v-x0)/((x1-x0)||1)*(W-P.l-P.r), Y=v=>P.t+(1-(v-mn)/(mx-mn))*(H-P.t-P.b);
  let g='';
  for(let i=0;i<=4;i++){ const v=mn+(mx-mn)*i/4, y=Y(v);
    g+=`<line x1="${P.l}" y1="${y}" x2="${W-P.r}" y2="${y}" stroke="#2a423b" stroke-width="1"/>
        <text x="${P.l-7}" y="${y+4}" fill="#8fa8a0" font-size="11" text-anchor="end">${v.toFixed(1)}</text>`; }
  series.forEach(s=>{
    const pts=s.pts.filter(p=>p[1]!=null);
    if(!pts.length) return;
    const d=pts.map((p,i)=>(i?'L':'M')+X(p[0])+' '+Y(p[1])).join(' ');
    g+=`<path d="${d}" fill="none" stroke="${s.color}" stroke-width="${s.w||2.5}" ${s.dash?'stroke-dasharray="5 4"':''} stroke-linejoin="round"/>`;
    if(!s.dash) pts.forEach(p=>g+=`<circle cx="${X(p[0])}" cy="${Y(p[1])}" r="3.5" fill="${s.color}"/>`);
  });
  for(let i=0;i<=Math.min(6,x1-x0);i++){ const v=x0+Math.round((x1-x0)*i/Math.min(6,x1-x0||1));
    g+=`<text x="${X(v)}" y="${H-8}" fill="#8fa8a0" font-size="11" text-anchor="middle">S${v}</text>`; }
  svg.innerHTML=g;
}
function weeklyAvgWeights(){
  const by={}; D.weights.forEach(x=>{const w=weekOf(x.date); (by[w]=by[w]||[]).push(x.kg)});
  return Object.keys(by).map(k=>[+k, by[k].reduce((a,b)=>a+b,0)/by[k].length]).sort((a,b)=>a[0]-b[0]);
}
function drawCharts(){
  const real=weeklyAvgWeights(); const maxW=Math.max(curWeek(), real.length?real[real.length-1][0]:1);
  const planP=PLAN.slice(0,maxW).map((p,i)=>[i+1,p[0]]);
  line('chPeso',[{pts:planP,color:'#8fa8a0',dash:1,w:2},{pts:real,color:'#4ecfa8'}]);

  const cin=D.measures.filter(m=>m.cin).map(m=>[weekOf(m.date),m.cin]);
  const maxC=Math.max(curWeek(), cin.length?cin[cin.length-1][0]:1);
  line('chCin',[{pts:PLAN.slice(0,maxC).map((p,i)=>[i+1,p[1]]),color:'#8fa8a0',dash:1,w:2},{pts:cin,color:'#4ecfa8'}]);

  const vb={}; D.workouts.forEach(w=>{const k=weekOf(w.date);
    vb[k]=(vb[k]||0)+w.sets.reduce((s,y)=>s+y.w*y.r,0)/1000;});
  line('chVol',[{pts:Object.keys(vb).map(k=>[+k,vb[k]]).sort((a,b)=>a[0]-b[0]),color:'#4ecfa8'}]);
}

/* ============ DATOS ============ */
function exportData(){
  const b=new Blob([JSON.stringify(D,null,2)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(b);
  a.download='diario_gym_'+today()+'.json'; a.click(); toast('Respaldo descargado');
}
function importData(e){
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=ev=>{ try{ const o=JSON.parse(ev.target.result);
    if(!o.weights) throw 0; D=o; save(); init(); toast('Datos importados'); }
    catch(x){ toast('Archivo inválido'); } };
  r.readAsText(f);
}
function saveCfg(){
  D.cfg.start=document.getElementById('cfgStart').value||D.cfg.start;
  D.cfg.height=parseFloat(document.getElementById('cfgH').value)||D.cfg.height;
  D.cfg.w0=parseFloat(document.getElementById('cfgW0').value)||D.cfg.w0;
  save(); render(); toast('Configuración guardada');
}
function wipe(){ if(!confirm('¿Borrar TODOS tus registros? Esto no se puede deshacer.')) return;
  localStorage.removeItem(KEY); D=load(); init(); toast('Todo borrado'); }

/* ============ INIT ============ */
function init(){
  ['qDate','wDate','pDate','mDate','sDate'].forEach(i=>document.getElementById(i).value=today());
  const sel=document.getElementById('wRoutine');
  sel.innerHTML=Object.keys(ROUTINES).map(k=>`<option value="${k}">${ROUTINES[k].name}</option>`).join('');
  document.getElementById('cfgStart').value=D.cfg.start;
  document.getElementById('cfgH').value=D.cfg.height;
  document.getElementById('cfgW0').value=D.cfg.w0;
  renderExercises(); render(); drawCharts();
}
init();

/* ============ PWA ============ */
if('serviceWorker' in navigator){
  window.addEventListener('load',()=>navigator.serviceWorker.register('sw.js').catch(()=>{}));
}
function hideHint(){ try{localStorage.setItem('hideIosHint','1')}catch(e){}
  document.getElementById('iosHint').style.display='none'; }
(function(){
  const iOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
  const standalone = window.navigator.standalone===true ||
                     (typeof window.matchMedia==='function' &&
                      window.matchMedia('(display-mode: standalone)').matches);
  let hidden=false; try{ hidden = localStorage.getItem('hideIosHint')==='1'; }catch(e){}
  if(iOS && !standalone && !hidden) document.getElementById('iosHint').style.display='block';
})();

/* Aviso de respaldo cada 30 días */
(function(){
  try{
    const last = localStorage.getItem('lastBackup');
    const days = last ? (Date.now()-(+last))/864e5 : null;
    if(D.weights.length>10 && (last===null || days>30)){
      setTimeout(()=>toast('Han pasado 30 días: exporta tu respaldo'),1800);
    }
  }catch(e){}
})();
const _exp = exportData;
exportData = function(){ try{localStorage.setItem('lastBackup',Date.now())}catch(e){} _exp(); };
</script>
</body>
</html>
